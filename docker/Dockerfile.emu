# melonDS (built from source) under a virtual X server, for smoke-testing
# the DS build with tools/ds-smoke.sh. melonDS boots homebrew with its
# built-in free BIOS and can expose a host folder as the DLDI SD card.
FROM debian:bookworm AS build
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git build-essential cmake \
    ninja-build pkg-config extra-cmake-modules qt6-base-dev qt6-base-private-dev \
    qt6-multimedia-dev qt6-svg-dev libqt6opengl6-dev libsdl2-dev libarchive-dev libenet-dev libzstd-dev \
    libfaad-dev libslirp-dev libgl-dev libwayland-dev \
 && rm -rf /var/lib/apt/lists/*
RUN git clone --depth 1 https://github.com/melonDS-emu/melonDS.git /melonDS
WORKDIR /melonDS
RUN cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=Release -DUSE_QT6=ON -DENABLE_JIT=ON \
 && cmake --build build \
 && install -m755 build/melonDS /usr/local/bin/melonDS

FROM debian:bookworm
RUN apt-get update \
 && apt-get install -y --no-install-recommends libqt6widgets6 libqt6gui6 libqt6core6 \
    libqt6network6 libqt6multimedia6 libqt6svg6 libqt6opengl6 libqt6openglwidgets6 \
    qt6-qpa-plugins libsdl2-2.0-0 libarchive13 libenet7 libzstd1 libfaad2 libslirp0 \
    libgl1 libegl1 libgl1-mesa-dri xvfb x11-apps imagemagick xdotool dosfstools mtools \
    pulseaudio pulseaudio-utils \
 && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/bin/melonDS /usr/local/bin/melonDS
WORKDIR /src
